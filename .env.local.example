# ---------------------------------------------------------------------------
# IBS Consultancy — environment variables
# Copy this file to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://ibsconsultancy.ae

# Company contact details shown across the site (safe to expose publicly)
NEXT_PUBLIC_PHONE=+971500000000
NEXT_PUBLIC_WHATSAPP=971500000000
NEXT_PUBLIC_EMAIL=info@ibsconsultancy.ae

# ---- Admin dashboard login ----
# Username + password to sign in at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
# Secret used to sign the admin session cookie (any long random string)
AUTH_SECRET=replace-with-a-long-random-string-min-32-chars

# ---- Lead storage (optional) ----
# By default leads are written to a JSON file (data/leads.json locally,
# /tmp on serverless). For durable production storage on Vercel, create a
# Vercel KV store and these two vars are injected automatically:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Optional: email/CRM notification webhook ----
# If set, each new lead is POSTed as JSON to this URL (Zapier/Make/CRM/Slack).
LEAD_WEBHOOK_URL=
